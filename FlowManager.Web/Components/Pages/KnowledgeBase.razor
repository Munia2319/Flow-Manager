@page "/knowledgebase"
@rendermode InteractiveServer
@using FlowManager.Core.Models.KnowledgeBase
@using FlowManager.Core.Services.KnowledgeBase
@inject IKnowledgeBaseService KnowledgeBaseService
@inject IJSRuntime JSRuntime

<PageTitle>Knowledge Base</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h2">📚 Knowledge Base</h1>
            <p class="text-muted">Manage company documents, policies, procedures, and manuals</p>
        </div>
    </div>

    <!-- Upload Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📤 Upload Documents</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="fileInput" class="form-label">Select File (PDF, DOCX, TXT, MD)</label>
                        <InputFile OnChange="HandleFileSelected" class="form-control" id="fileInput" accept=".pdf,.docx,.txt,.md" />
                        @if (!string.IsNullOrEmpty(_uploadMessage))
                        {
                            <div class="alert alert-info mt-2">@_uploadMessage</div>
                        }
                    </div>

                    @if (_selectedFile != null)
                    {
                        <div class="mb-3">
                            <label for="documentTitle" class="form-label">Document Title</label>
                            <input type="text" class="form-control" id="documentTitle" @bind="_documentTitle" placeholder="Enter document title" />
                        </div>

                        <div class="mb-3">
                            <label for="documentCategory" class="form-label">Category</label>
                            <select class="form-select" id="documentCategory" @bind="_selectedCategory">
                                @foreach (DocumentCategory category in Enum.GetValues(typeof(DocumentCategory)))
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                        </div>

                        <button class="btn btn-primary" @onclick="UploadDocument" disabled="@_isUploading">
                            @if (_isUploading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Uploading...</span>
                            }
                            else
                            {
                                <span>Upload & Process</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Document Library -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">📄 Document Library</h5>
                    <button class="btn btn-sm btn-light" @onclick="LoadDocuments">
                        <span>🔄 Refresh</span>
                    </button>
                </div>
                <div class="card-body">
                    @if (_isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary"></div>
                            <p class="mt-2">Loading documents...</p>
                        </div>
                    }
                    else if (!_documents.Any())
                    {
                        <div class="alert alert-info">
                            <strong>No documents yet.</strong> Upload your first document to get started!
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Category</th>
                                        <th>Upload Date</th>
                                        <th>Size</th>
                                        <th>Status</th>
                                        <th>Chunks</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in _documents.OrderByDescending(d => d.UploadDate))
                                    {
                                        <tr>
                                            <td>
                                                <strong>@doc.Title</strong>
                                                <br />
                                                <small class="text-muted">@doc.OriginalFileName</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@doc.Category</span>
                                            </td>
                                            <td>@doc.UploadDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@FormatFileSize(doc.FileSize)</td>
                                            <td>
                                                @switch (doc.Status)
                                                {
                                                    case ProcessingStatus.Pending:
                                                        <span class="badge bg-secondary">⏳ Pending</span>
                                                        break;
                                                    case ProcessingStatus.Processing:
                                                        <span class="badge bg-warning">⚙️ Processing</span>
                                                        break;
                                                    case ProcessingStatus.Indexed:
                                                        <span class="badge bg-success">✅ Indexed</span>
                                                        break;
                                                    case ProcessingStatus.Failed:
                                                        <span class="badge bg-danger">❌ Failed</span>
                                                        break;
                                                }
                                            </td>
                                            <td>@doc.ChunkCount</td>
                                            <td>
                                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteDocument(doc.Id)">
                                                    🗑️ Delete
                                                </button>
                                            </td>
                                        </tr>
                                        @if (doc.Status == ProcessingStatus.Failed && !string.IsNullOrEmpty(doc.ErrorMessage))
                                        {
                                            <tr>
                                                <td colspan="7">
                                                    <div class="alert alert-danger mb-0">
                                                        <strong>Error:</strong> @doc.ErrorMessage
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Statistics -->
                        <div class="row mt-4">
                            <div class="col-md-3">
                                <div class="card bg-light">
                                    <div class="card-body text-center">
                                        <h3 class="mb-0">@_documents.Count</h3>
                                        <small class="text-muted">Total Documents</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-light">
                                    <div class="card-body text-center">
                                        <h3 class="mb-0">@_documents.Count(d => d.Status == ProcessingStatus.Indexed)</h3>
                                        <small class="text-muted">Indexed</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-light">
                                    <div class="card-body text-center">
                                        <h3 class="mb-0">@_documents.Sum(d => d.ChunkCount)</h3>
                                        <small class="text-muted">Total Chunks</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-light">
                                    <div class="card-body text-center">
                                        <h3 class="mb-0">@FormatFileSize(_documents.Sum(d => d.FileSize))</h3>
                                        <small class="text-muted">Total Size</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<KnowledgeDocument> _documents = new();
    private IBrowserFile? _selectedFile;
    private string _documentTitle = string.Empty;
    private DocumentCategory _selectedCategory = DocumentCategory.General;
    private bool _isUploading = false;
    private bool _isLoading = false;
    private string _uploadMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        _isLoading = true;
        try
        {
            _documents = await KnowledgeBaseService.GetAllDocumentsAsync();
        }
        catch (Exception ex)
        {
            _uploadMessage = $"Error loading documents: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _documentTitle = Path.GetFileNameWithoutExtension(e.File.Name);
        _uploadMessage = $"Selected: {e.File.Name} ({FormatFileSize(e.File.Size)})";
        StateHasChanged(); // Force UI refresh to show title, category, and upload button
    }

    private async Task UploadDocument()
    {
        if (_selectedFile == null) return;

        _isUploading = true;
        _uploadMessage = "Uploading and processing document...";

        try
        {
            using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max

            var document = await KnowledgeBaseService.UploadDocumentAsync(
                stream,
                _selectedFile.Name,
                _selectedCategory,
                new Dictionary<string, string>
                {
                    ["uploadedBy"] = "User",
                    ["customTitle"] = _documentTitle
                }
            );

            _uploadMessage = $"✅ Document uploaded successfully! Processing in background...";

            // Reset form
            _selectedFile = null;
            _documentTitle = string.Empty;

            // Reload documents after a short delay
            await Task.Delay(1000);
            await LoadDocuments();
        }
        catch (Exception ex)
        {
            _uploadMessage = $"❌ Error: {ex.Message}";
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task DeleteDocument(Guid documentId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this document?"))
        {
            return;
        }

        try
        {
            var success = await KnowledgeBaseService.DeleteDocumentAsync(documentId);
            if (success)
            {
                _uploadMessage = "✅ Document deleted successfully";
                await LoadDocuments();
            }
            else
            {
                _uploadMessage = "❌ Failed to delete document";
            }
        }
        catch (Exception ex)
        {
            _uploadMessage = $"❌ Error: {ex.Message}";
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
