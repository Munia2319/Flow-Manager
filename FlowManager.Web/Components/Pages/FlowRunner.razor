@code {
    [Parameter]
    public string? FlowId { get; set; }

    [Parameter]
    public string? ConversationId { get; set; }

    private Flow? flow;
    private ExecutionContext? executionContext;
    private bool isRunning = false;
    private string? errorMessage;

    // 🆕 DYNAMIC INPUT
    private string userInput = "";
    private string currentInputUsed = "";

    // 🆕 EXECUTION HISTORY
    private List<ExecutionRun> executionHistory = new();

    // ✨ NEW: CONVERSATION MEMORY (now managed by IConversationStore)
    // Loaded from store on initialization
    // Automatically saved after each message
    private ConversationMemory? conversationMemory;

    // ✨ Phase 6: PII REDACTION CONFIGURATION
    // Enable automatic PII detection and redaction
    private bool enablePIIRedaction = true;
    private RedactionStrategy piiRedactionStrategy = RedactionStrategy.Mask;

    private class ExecutionRun
    {
        public DateTime Timestamp { get; set; }
        public string Input { get; set; } = "";
        public bool Success { get; set; }
    }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(FlowId))
        {
            try
            {
                // Load flow
                flow = Storage.LoadFlow(FlowId);

                // Set default input from first Input node if exists
                var inputNode = flow.Nodes.FirstOrDefault(n => n.Type == "Input");
                if (inputNode != null && inputNode.Config.ContainsKey("text"))
                {
                    userInput = inputNode.Config["text"]?.ToString() ?? "";
                }

                Console.WriteLine($"✅ Flow loaded: {flow.Name}");

                // ✨ NEW: Load or create conversation
                if (!string.IsNullOrEmpty(ConversationId))
                {
                    // Load existing conversation
                    conversationMemory = ConversationStore.Load(ConversationId);
                    if (conversationMemory == null)
                    {
                        // Conversation ID was provided but doesn't exist - create new
                        conversationMemory = ConversationStore.CreateNew();
                        Console.WriteLine($"⚠️ Conversation {ConversationId} not found, created new: {conversationMemory.ConversationId}");
                    }
                    else
                    {
                        Console.WriteLine($"✅ Loaded existing conversation: {conversationMemory.ConversationId} ({conversationMemory.Messages.Count} messages)");
                    }
                }
                else
                {
                    // No conversation ID provided - create new conversation
                    conversationMemory = ConversationStore.CreateNew();
                    Console.WriteLine($"✨ Created new conversation: {conversationMemory.ConversationId}");
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error loading flow: {ex.Message}";
            }
        }
    }

    private async Task StartExecution()
    {
        if (flow == null || string.IsNullOrWhiteSpace(userInput)) return;

        isRunning = true;
        executionContext = null;
        errorMessage = null;
        currentInputUsed = userInput.Trim();
        
        await InvokeAsync(StateHasChanged);
        await Task.Delay(100);

        try
        {
            if (conversationMemory == null)
            {
                errorMessage = "Conversation not initialized";
                return;
            }

            // ✨ STEP 1: Detect topic continuity (Phase 4)
            // This helps identify if user is switching topics
            var topicMetadata = new Dictionary<string, object>();

            // Get API key for topic detection (same as orchestrator)
            var orchestratorNode = flow?.Nodes.FirstOrDefault(n => n.Type == "Orchestrator");
            if (orchestratorNode != null && orchestratorNode.Config.ContainsKey("apiKey"))
            {
                var apiKey = orchestratorNode.Config["apiKey"]?.ToString();
                if (!string.IsNullOrEmpty(apiKey))
                {
                    try
                    {
                        var topicDetector = new TopicContinuityDetector(apiKey);
                        var recentMessages = conversationMemory.GetRecentMessages(5);
                        var topicResult = await topicDetector.DetectContinuityAsync(currentInputUsed, recentMessages);

                        // Store topic metadata
                        topicMetadata["TopicSimilarity"] = topicResult.SimilarityScore;
                        topicMetadata["IsTopicChange"] = topicResult.IsTopicChange;
                        topicMetadata["TopicDetectionMethod"] = topicResult.DetectionMethod;

                        Console.WriteLine($"[FlowRunner] 🎯 Topic continuity: {topicResult.SimilarityScore:P0} ({topicResult.DetectionMethod}) - {topicResult.Reason}");

                        if (topicResult.IsTopicChange)
                        {
                            Console.WriteLine($"[FlowRunner] 🔄 Topic change detected!");
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[FlowRunner] ⚠️ Topic detection failed: {ex.Message}");
                    }
                }
            }

            // ✨ STEP 2: PII Detection and Redaction (Phase 6)
            var messageContent = currentInputUsed;
            if (enablePIIRedaction && PIIRedactor.ShouldRedact("user", enablePIIRedaction))
            {
                var redactionResult = PIIRedactor.RedactPII(currentInputUsed, piiRedactionStrategy, enablePIIRedaction);

                if (redactionResult.RedactionApplied)
                {
                    // Use redacted content
                    messageContent = redactionResult.RedactedText;

                    // Add PII metadata
                    topicMetadata["PIIRedacted"] = true;
                    topicMetadata["PIICount"] = redactionResult.DetectedPII.Count;
                    topicMetadata["RedactionStrategy"] = piiRedactionStrategy.ToString();
                    topicMetadata["RedactionSummary"] = redactionResult.GetSummary();

                    var piiTypes = redactionResult.DetectedPII.Select(p => p.Type.ToString()).Distinct().ToList();
                    topicMetadata["PIITypes"] = string.Join(", ", piiTypes);

                    Console.WriteLine($"[FlowRunner] 🔒 {redactionResult.GetSummary()}");
                }
            }

            // ✨ STEP 3: Add user message to conversation history BEFORE execution
            var userMessage = new ConversationMessage
            {
                Role = "user",
                Content = messageContent,  // Use potentially redacted content
                Timestamp = DateTime.UtcNow,
                Metadata = topicMetadata  // Include topic + PII metadata
            };
            ConversationStore.Append(conversationMemory.ConversationId, userMessage);

            // Reload conversation to get updated message count
            conversationMemory = ConversationStore.Load(conversationMemory.ConversationId);
            Console.WriteLine($"💬 Added user message to conversation (total messages: {conversationMemory?.Messages.Count ?? 0})");

            // ✨ STEP 4: UPDATE THE INPUT NODE WITH USER'S INPUT
            var flowCopy = CloneFlow(flow);
            var inputNode = flowCopy.Nodes.FirstOrDefault(n => n.Type == "Input");
            if (inputNode != null)
            {
                inputNode.Config["text"] = currentInputUsed;
            }

            // ✨ STEP 5: Execute flow WITH conversation memory
            Console.WriteLine($"🚀 Executing with input: {currentInputUsed}");
            executionContext = await Orchestrator.ExecuteFlowAsync(flowCopy, 3, conversationMemory);

            // ✨ STEP 6: Add assistant response to conversation AFTER execution
            if (executionContext.Status == ExecutionStatus.Completed)
            {
                // ✨ Phase 5: Check if orchestrator requested clarification
                ConversationMessage? assistantMessage = null;

                if (executionContext.NodeOutputs.ContainsKey("orchestrator1"))
                {
                    var orchOutputs = executionContext.NodeOutputs["orchestrator1"];

                    // Check if clarification is needed
                    var clarificationRequest = ClarificationHandler.CheckNeedsClarification(orchOutputs);

                    if (clarificationRequest != null)
                    {
                        // Clarification needed - create clarification message
                        Console.WriteLine($"[FlowRunner] ❓ Clarification needed (confidence: {clarificationRequest.Confidence}%)");
                        assistantMessage = ClarificationHandler.CreateClarificationMessage(clarificationRequest);
                    }
                    else
                    {
                        // Normal flow - get output from departments
                        var finalOutput = GetFinalOutput(executionContext);

                        if (!string.IsNullOrEmpty(finalOutput))
                        {
                            // Store metadata from orchestrator
                            var metadata = new Dictionary<string, object>();

                            if (orchOutputs.ContainsKey("targets"))
                            {
                                metadata["triggeredDepartment"] = orchOutputs["targets"]?.ToString() ?? "";
                            }

                            // ✨ Phase 5: Add confidence and reasoning
                            if (orchOutputs.ContainsKey("confidence"))
                            {
                                metadata["Confidence"] = orchOutputs["confidence"];
                            }

                            if (orchOutputs.ContainsKey("reasoning"))
                            {
                                metadata["Reasoning"] = orchOutputs["reasoning"]?.ToString() ?? "";
                            }

                            // ✨ NEW: Add search metadata from Search Department
                            var searchDeptId = "search1";
                            if (executionContext.NodeOutputs.ContainsKey(searchDeptId))
                            {
                                var searchOutputs = executionContext.NodeOutputs[searchDeptId];

                                if (searchOutputs.ContainsKey("source"))
                                {
                                    metadata["SearchSource"] = searchOutputs["source"]?.ToString() ?? "";
                                }

                                if (searchOutputs.ContainsKey("confidence"))
                                {
                                    metadata["KBConfidence"] = searchOutputs["confidence"]?.ToString() ?? "0";
                                }

                                if (searchOutputs.ContainsKey("internalSources"))
                                {
                                    metadata["InternalSourcesCount"] = searchOutputs["internalSources"]?.ToString() ?? "0";
                                }

                                if (searchOutputs.ContainsKey("externalSources"))
                                {
                                    metadata["ExternalSourcesCount"] = searchOutputs["externalSources"]?.ToString() ?? "0";
                                }
                            }

                            assistantMessage = new ConversationMessage
                            {
                                Role = "assistant",
                                Content = finalOutput,
                                Timestamp = DateTime.UtcNow,
                                Metadata = metadata
                            };
                        }
                    }
                }
                else
                {
                    // No orchestrator - just get final output
                    var finalOutput = GetFinalOutput(executionContext);
                    if (!string.IsNullOrEmpty(finalOutput))
                    {
                        assistantMessage = new ConversationMessage
                        {
                            Role = "assistant",
                            Content = finalOutput,
                            Timestamp = DateTime.UtcNow
                        };
                    }
                }

                // Save assistant message if we have one
                if (assistantMessage != null)
                {
                    ConversationStore.Append(conversationMemory.ConversationId, assistantMessage);

                    // Reload conversation
                    conversationMemory = ConversationStore.Load(conversationMemory.ConversationId);
                    Console.WriteLine($"💬 Added assistant response to conversation (total messages: {conversationMemory?.Messages.Count ?? 0})");

                    // ✨ Phase 3: Check if conversation needs trimming
                    if (conversationMemory != null && conversationMemory.NeedsTrimming())
                    {
                        Console.WriteLine($"[FlowRunner] ⚠️ Conversation needs trimming! Current tokens: {conversationMemory.GetEstimatedTokenCount()} / {conversationMemory.TrimThreshold}");
                        await TrimConversationAsync(conversationMemory);
                    }
                }
            }

            // Add to history
            executionHistory.Insert(0, new ExecutionRun
            {
                Timestamp = DateTime.Now,
                Input = currentInputUsed,
                Success = executionContext.Status == ExecutionStatus.Completed
            });
            
            Console.WriteLine($"✅ Execution completed: {executionContext.Status}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Execution error: {ex.Message}";
            executionHistory.Insert(0, new ExecutionRun
            {
                Timestamp = DateTime.Now,
                Input = currentInputUsed,
                Success = false
            });
        }
        finally
        {
            isRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void RunAgain()
    {
        executionContext = null;
        errorMessage = null;
        // Keep the userInput so they can modify it
    }
    
    private async Task RunSameInput()
    {
        // Run with the same input again
        await StartExecution();
    }

    private Flow CloneFlow(Flow original)
    {
        // Simple clone - in production, use proper deep cloning
        return new Flow
        {
            Id = original.Id,
            Name = original.Name,
            Nodes = original.Nodes.Select(n => new NodeDefinition
            {
                Id = n.Id,
                Type = n.Type,
                Config = new Dictionary<string, object>(n.Config),
                Condition = n.Condition
            }).ToList(),
            Edges = original.Edges.Select(e => new Edge
            {
                From = e.From,
                To = e.To,
                FromOutput = e.FromOutput,
                ToInput = e.ToInput,
                Condition = e.Condition  // ✅ FIX: Copy the condition field!
            }).ToList(),
            CreatedAt = original.CreatedAt,
            UpdatedAt = original.UpdatedAt
        };
    }

    // ✨ NEW: Extract final output from execution context
    // This gets the formatted response that will be added to conversation memory
    private string GetFinalOutput(ExecutionContext context)
    {
        // Priority 1: Try to get output from FormatterNode
        if (context.NodeOutputs.ContainsKey("formatter1"))
        {
            var formatterOutputs = context.NodeOutputs["formatter1"];
            if (formatterOutputs.ContainsKey("output"))
            {
                return formatterOutputs["output"]?.ToString() ?? "";
            }
        }

        // Priority 2: Try to get output from any department node that ran
        var departmentTypes = new[] { "search1", "data1", "function1", "image1" };
        foreach (var deptId in departmentTypes)
        {
            if (context.NodeOutputs.ContainsKey(deptId))
            {
                var deptOutputs = context.NodeOutputs[deptId];
                if (deptOutputs.ContainsKey("output") && deptOutputs["output"] != null)
                {
                    var output = deptOutputs["output"]?.ToString() ?? "";
                    if (!string.IsNullOrEmpty(output))
                    {
                        return output;
                    }
                }
            }
        }

        // Priority 3: Fallback to any node with "output"
        foreach (var nodeOutput in context.NodeOutputs.Values)
        {
            if (nodeOutput.ContainsKey("output") && nodeOutput["output"] != null)
            {
                var output = nodeOutput["output"]?.ToString() ?? "";
                if (!string.IsNullOrEmpty(output))
                {
                    return output;
                }
            }
        }

        return "";
    }

    // ✨ NEW Phase 3: Automatically trim conversation when token budget is exceeded
    private async Task TrimConversationAsync(ConversationMemory conversation)
    {
        try
        {
            Console.WriteLine($"[FlowRunner] 🔄 Starting conversation trimming...");

            // Get messages that need to be summarized
            var messagesToSummarize = conversation.GetMessagesToSummarize();
            if (messagesToSummarize.Count == 0)
            {
                Console.WriteLine($"[FlowRunner] ⚠️ No messages to summarize");
                return;
            }

            Console.WriteLine($"[FlowRunner] 📝 Summarizing {messagesToSummarize.Count} messages...");

            // Get API key from orchestrator node (needed for OpenAI summarization)
            var orchestratorNode = flow?.Nodes.FirstOrDefault(n => n.Type == "Orchestrator");
            if (orchestratorNode == null || !orchestratorNode.Config.ContainsKey("apiKey"))
            {
                Console.WriteLine($"[FlowRunner] ❌ Cannot trim: No orchestrator node or API key not found");
                return;
            }

            var apiKey = orchestratorNode.Config["apiKey"]?.ToString();
            if (string.IsNullOrEmpty(apiKey))
            {
                Console.WriteLine($"[FlowRunner] ❌ Cannot trim: API key is empty");
                return;
            }

            // Create summarizer and generate summary
            var summarizer = new ConversationSummarizer(apiKey);
            var summary = await summarizer.SummarizeAsync(messagesToSummarize);

            Console.WriteLine($"[FlowRunner] ✅ Summary generated: {summary.Substring(0, Math.Min(100, summary.Length))}...");

            // Apply the trim (moves old messages to Summaries list, keeps recent messages)
            conversation.Trim(summary);

            // Save the updated conversation
            ConversationStore.Save(conversation);

            Console.WriteLine($"[FlowRunner] 💾 Trimmed conversation saved");
            Console.WriteLine($"[FlowRunner] 📊 New state: {conversation.Summaries.Count} summaries, {conversation.Messages.Count} messages, {conversation.GetEstimatedTokenCount()} tokens");

            // Reload to ensure UI is in sync
            conversationMemory = ConversationStore.Load(conversation.ConversationId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FlowRunner] ❌ Error during trimming: {ex.Message}");
            // Don't throw - trimming is an optimization, not critical
        }
    }

