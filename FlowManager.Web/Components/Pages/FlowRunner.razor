@rendermode InteractiveServer
@page "/flows/run/{FlowId}"
@page "/flows/run/{FlowId}/{ConversationId}"
@using FlowManager.Core.Models
@using FlowManager.Core.Models.KnowledgeBase
@using FlowManager.Core.Services
@using FlowManager.Core.Engine
@inject FlowStorageService Storage
@inject FlowOrchestrator Orchestrator
@inject NavigationManager Navigation
@inject IConversationStore ConversationStore

<PageTitle>Run Flow - @(flow?.Name ?? "Flow")</PageTitle>

<div class="container-fluid mt-4">
    <div class="row">
        <!-- Left Sidebar: Flow Info & Controls -->
        <div class="col-md-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2>▶️ Run Flow</h2>
                <button class="btn btn-outline-secondary" @onclick="GoBack">
                    <i class="bi bi-arrow-left"></i> Back
                </button>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>Error:</strong> @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }

            @if (flow == null)
            {
                <div class="alert alert-danger">
                    <h4>Flow not found!</h4>
                    <p>Flow ID: @FlowId</p>
                </div>
            }
            else
            {
                <!-- Flow Info Card -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-diagram-3"></i> @flow.Name
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <i class="bi bi-circle-fill text-primary"></i>
                            <strong>Nodes:</strong> @flow.Nodes.Count
                        </div>
                        <div class="mb-2">
                            <i class="bi bi-arrow-left-right text-success"></i>
                            <strong>Edges:</strong> @flow.Edges.Count
                        </div>
                        <div>
                            <i class="bi bi-clock-history"></i>
                            <strong>Created:</strong> @flow.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                        </div>
                    </div>
                </div>

                <!-- 🆕 DYNAMIC INPUT CARD -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-chat-left-text"></i> Input
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Your Question:</label>
                            <textarea class="form-control" 
                                      @bind="userInput" 
                                      rows="4" 
                                      placeholder="Type your question here...&#10;&#10;Examples:&#10;- When was Tesla founded?&#10;- What are the forklift safety procedures?&#10;- Extract product code from: XYZ-123"></textarea>
                        </div>
                        <div class="text-muted">
                            <small>
                                <i class="bi bi-lightbulb"></i> 
                                <strong>Tip:</strong> The orchestrator will automatically route your question to the right department!
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Execution Control Card -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-gear"></i> Execution Control
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (!isRunning && executionContext == null)
                        {
                            <div class="d-grid">
                                <button class="btn btn-success btn-lg" 
                                        @onclick="StartExecution"
                                        disabled="@string.IsNullOrWhiteSpace(userInput)">
                                    <i class="bi bi-play-fill"></i> Start Execution
                                </button>
                            </div>
                            @if (string.IsNullOrWhiteSpace(userInput))
                            {
                                <p class="text-danger mt-2 mb-0 text-center">
                                    <small><i class="bi bi-exclamation-circle"></i> Please enter a question first</small>
                                </p>
                            }
                            else
                            {
                                <p class="text-muted mt-2 mb-0 text-center">
                                    <small>Click to run with your input</small>
                                </p>
                            }
                        }
                        else if (isRunning)
                        {
                            <div class="text-center">
                                <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                                    <span class="visually-hidden">Running...</span>
                                </div>
                                <h5>Executing Flow...</h5>
                                <p class="text-muted">Processing: "@currentInputUsed"</p>
                                <div class="progress">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" 
                                         role="progressbar" 
                                         style="width: 100%"></div>
                                </div>
                            </div>
                        }
                        else if (executionContext != null)
                        {
                            <div class="alert alert-@(executionContext.Status == ExecutionStatus.Completed ? "success" : "danger") mb-3">
                                <h5 class="mb-2">
                                    @if (executionContext.Status == ExecutionStatus.Completed)
                                    {
                                        <i class="bi bi-check-circle"></i> <span>Completed!</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle"></i> <span>Failed</span>
                                    }
                                </h5>
                                <small>
                                    <i class="bi bi-stopwatch"></i>
                                    Duration: @((executionContext.EndTime - executionContext.StartTime)?.TotalSeconds.ToString("F2"))s
                                </small>
                            </div>
                            <div class="d-grid gap-2">
                                <button class="btn btn-primary" @onclick="RunAgain">
                                    <i class="bi bi-arrow-clockwise"></i> Run with New Input
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="RunSameInput">
                                    <i class="bi bi-repeat"></i> Run Same Input Again
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Previous Runs History -->
                @if (executionHistory.Any())
                {
                    <div class="card shadow-sm">
                        <div class="card-header bg-secondary text-white">
                            <h6 class="mb-0">
                                <i class="bi bi-clock-history"></i> History (@executionHistory.Count runs)
                            </h6>
                        </div>
                        <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var run in executionHistory.Take(10))
                            {
                                <div class="mb-2 p-2 border-bottom">
                                    <div class="d-flex justify-content-between">
                                        <small class="text-muted">@run.Timestamp.ToString("HH:mm:ss")</small>
                                        <span class="badge bg-@(run.Success ? "success" : "danger")">
                                            @(run.Success ? "✓" : "✗")
                                        </span>
                                    </div>
                                    <small class="text-truncate d-block">@run.Input</small>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- 🔥 EXECUTION ORDER CARD - SHOWS BATCHES AND PARALLEL EXECUTION -->
                @if (executionContext != null && executionContext.ExecutionBatches.Any())
                {
                    <div class="card shadow-sm mt-3">
                        <div class="card-header bg-info text-white">
                            <h6 class="mb-0">
                                <i class="bi bi-list-ol"></i> Execution Order
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="execution-flow">
                                @{
                                    int nodeCounter = 0;
                                }
                                @for (int batchIndex = 0; batchIndex < executionContext.ExecutionBatches.Count; batchIndex++)
                                {
                                    var batch = executionContext.ExecutionBatches[batchIndex];

                                    // Filter out skipped nodes (departments with no data)
                                    var activeBatchNodes = batch.Where(nodeId => {
                                        var nodeDef = flow?.Nodes.FirstOrDefault(n => n.Id == nodeId);
                                        var hasOutput = executionContext.NodeOutputs.ContainsKey(nodeId);
                                        var outputs = hasOutput ? executionContext.NodeOutputs[nodeId] : null;
                                        var hasData = outputs != null && outputs.Any();

                                        bool isDepartment = nodeDef?.Type?.EndsWith("Department") == true;
                                        if (isDepartment && !hasData)
                                        {
                                            return false;
                                        }

                                        return true;
                                    }).ToList();

                                    @if (activeBatchNodes.Any())
                                    {
                                        <div class="execution-batch">
                                            @if (activeBatchNodes.Count == 1)
                                            {
                                                <!-- Single node - normal display -->
                                                <div class="execution-step">
                                                    <span class="badge bg-primary">@(++nodeCounter)</span>
                                                    <span class="ms-2">@activeBatchNodes[0]</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <!-- Multiple nodes - parallel display -->
                                                <div class="parallel-batch">
                                                    <div class="batch-label text-muted mb-2">
                                                        <small><i class="bi bi-lightning-fill"></i> Parallel Execution</small>
                                                    </div>
                                                    <div class="parallel-nodes">
                                                        @foreach (var nodeId in activeBatchNodes)
                                                        {
                                                            <div class="execution-step parallel">
                                                                <span class="badge bg-primary">@(++nodeCounter)</span>
                                                                <span class="ms-2">@nodeId</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        @if (batchIndex < executionContext.ExecutionBatches.Count - 1)
                                        {
                                            <div class="execution-arrow">↓</div>
                                        }
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Right Panel: Results -->
        <div class="col-md-8">
            <!-- ✨ NEW: CONVERSATION HISTORY -->
            @if (conversationMemory != null && (conversationMemory.Messages.Count > 0 || conversationMemory.Summaries.Count > 0))
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="mb-0">
                                <i class="bi bi-chat-dots"></i> Conversation History
                            </h5>
                            <span class="badge bg-light text-dark">
                                @(conversationMemory.Summaries.Count + conversationMemory.Messages.Count) items
                            </span>
                        </div>
                        @* ✨ NEW Phase 3: Token usage indicator *@
                        <div class="d-flex justify-content-between align-items-center" style="font-size: 0.85rem;">
                            <div>
                                <i class="bi bi-speedometer2"></i>
                                <strong>@conversationMemory.GetEstimatedTokenCount()</strong> / @conversationMemory.TrimThreshold tokens
                            </div>
                            @if (conversationMemory.Summaries.Count > 0)
                            {
                                <div>
                                    <i class="bi bi-layers"></i> @conversationMemory.Summaries.Count summary(ies)
                                </div>
                            }
                        </div>
                        @* ✨ Token usage progress bar *@
                        <div class="progress mt-2" style="height: 6px;">
                            @{
                                var tokenPercentage = (double)conversationMemory.GetEstimatedTokenCount() / conversationMemory.TrimThreshold * 100;
                                var progressColor = tokenPercentage >= 100 ? "bg-danger" : tokenPercentage >= 80 ? "bg-warning" : "bg-success";
                            }
                            <div class="progress-bar @progressColor" role="progressbar"
                                 style="width: @Math.Min(100, tokenPercentage)%"></div>
                        </div>
                    </div>
                    <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                        @* ✨ NEW Phase 3: Show summaries first *@
                        @foreach (var summary in conversationMemory.Summaries)
                        {
                            <div class="message-bubble summary-message mb-3">
                                <div class="message-header">
                                    <strong>
                                        <i class="bi bi-collection"></i> Summary
                                    </strong>
                                    <small class="text-muted">@summary.Timestamp.ToLocalTime().ToString("HH:mm:ss")</small>
                                </div>
                                <div class="message-content">
                                    @summary.Content
                                </div>
                                @* Show summary metadata if available *@
                                @if (summary.Metadata.ContainsKey("SummarizedMessageCount"))
                                {
                                    <div class="message-meta">
                                        <small class="text-muted">
                                            <i class="bi bi-info-circle"></i>
                                            Condensed @summary.Metadata["SummarizedMessageCount"] messages
                                            @if (summary.Metadata.ContainsKey("TokensSaved"))
                                            {
                                                <span> • Saved @summary.Metadata["TokensSaved"] tokens</span>
                                            }
                                        </small>
                                    </div>
                                }
                            </div>
                        }

                        @* Regular messages *@
                        @foreach (var message in conversationMemory.Messages)
                        {
                            @* ✨ Phase 4: Topic change separator *@
                            @if (message.IsTopicChange && message.Role == "user")
                            {
                                <div class="topic-change-separator mb-3">
                                    <div class="topic-change-line"></div>
                                    <div class="topic-change-badge">
                                        <i class="bi bi-arrow-down-up"></i>
                                        Topic Change (@(message.GetTopicSimilarity().ToString("P0")) similarity)
                                    </div>
                                    <div class="topic-change-line"></div>
                                </div>
                            }

                            var isClarification = message.IsClarificationRequest;
                            var bubbleClass = isClarification ? "clarification-message" :
                                             message.Role == "user" ? "user-message" : "assistant-message";

                            <div class="message-bubble @bubbleClass mb-3">
                                <div class="message-header">
                                    <div>
                                        <strong>@(message.Role == "user" ? "You" : "Assistant")</strong>
                                        @* ✨ Phase 5: Show clarification badge *@
                                        @if (isClarification)
                                        {
                                            <span class="badge bg-warning text-dark ms-2">
                                                <i class="bi bi-question-circle"></i> Needs Clarification
                                            </span>
                                        }
                                        @* ✨ Phase 5: Show confidence badge *@
                                        @if (message.Role == "assistant" && !isClarification && message.Metadata.ContainsKey("Confidence"))
                                        {
                                            var confidence = message.GetConfidence();
                                            var confidenceColor = ClarificationHandler.GetConfidenceColor(confidence);
                                            var confidenceLevel = ClarificationHandler.FormatConfidenceLevel(confidence);
                                            <span class="badge bg-@confidenceColor ms-2">
                                                <i class="bi bi-speedometer2"></i> @confidence% (@confidenceLevel)
                                            </span>
                                        }
                                        @* ✨ Phase 6: Show PII redaction badge *@
                                        @if (message.HasPIIRedacted)
                                        {
                                            <span class="badge bg-danger ms-2" title="@message.GetPIISummary()">
                                                <i class="bi bi-shield-lock"></i> PII Redacted (@message.GetPIICount())
                                            </span>
                                        }
                                    </div>
                                    <small class="text-muted">@message.Timestamp.ToLocalTime().ToString("HH:mm:ss")</small>
                                </div>
                                <div class="message-content">
                                    @message.Content
                                </div>
                                @* ✨ Show metadata *@
                                @if (message.Metadata.Count > 0)
                                {
                                    <div class="message-meta">
                                        <small class="text-muted">
                                            @if (message.Metadata.ContainsKey("triggeredDepartment"))
                                            {
                                                <span>
                                                    <i class="bi bi-tag"></i> Department: @message.Metadata["triggeredDepartment"]
                                                </span>
                                            }
                                            @* ✨ Phase 4: Show topic similarity for user messages *@
                                            @if (message.Role == "user" && message.Metadata.ContainsKey("TopicSimilarity"))
                                            {
                                                var similarity = message.GetTopicSimilarity();
                                                var method = message.Metadata.ContainsKey("TopicDetectionMethod")
                                                    ? message.Metadata["TopicDetectionMethod"]?.ToString()
                                                    : "unknown";
                                                <span class="ms-2">
                                                    <i class="bi bi-graph-up"></i>
                                                    Similarity: @similarity.ToString("P0") (@method)
                                                </span>
                                            }
                                            @* ✨ Phase 5: Show reasoning *@
                                            @if (message.Metadata.ContainsKey("Reasoning"))
                                            {
                                                var reasoning = message.GetReasoning();
                                                if (!string.IsNullOrEmpty(reasoning))
                                                {
                                                    <span class="ms-2">
                                                        <i class="bi bi-lightbulb"></i>
                                                        @reasoning
                                                    </span>
                                                }
                                            }
                                            @* ✨ NEW: Show search source *@
                                            @if (message.Metadata.ContainsKey("SearchSource"))
                                            {
                                                var searchSource = message.Metadata["SearchSource"]?.ToString();
                                                var sourceIcon = searchSource switch
                                                {
                                                    "KnowledgeBase" => "🏢",
                                                    "WebSearch" => "🌐",
                                                    "Hybrid" => "🔄",
                                                    _ => "🤖"
                                                };
                                                <span class="ms-2">
                                                    <span>@sourceIcon</span>
                                                    Source: @searchSource
                                                </span>
                                            }
                                            @* ✨ NEW: Show KB confidence *@
                                            @if (message.Metadata.ContainsKey("KBConfidence"))
                                            {
                                                var kbConfidence = float.Parse(message.Metadata["KBConfidence"]?.ToString() ?? "0");
                                                <span class="ms-2">
                                                    <i class="bi bi-graph-up"></i>
                                                    KB Match: @(kbConfidence.ToString("P0"))
                                                </span>
                                            }
                                        </small>
                                    </div>
                                }
                                @* ✨ NEW: Show document references *@
                                @if (message.Metadata.ContainsKey("InternalSourcesCount") || message.Metadata.ContainsKey("ExternalSourcesCount"))
                                {
                                    var internalCount = message.Metadata.ContainsKey("InternalSourcesCount")
                                        ? int.Parse(message.Metadata["InternalSourcesCount"]?.ToString() ?? "0")
                                        : 0;
                                    var externalCount = message.Metadata.ContainsKey("ExternalSourcesCount")
                                        ? int.Parse(message.Metadata["ExternalSourcesCount"]?.ToString() ?? "0")
                                        : 0;

                                    @if (internalCount > 0 || externalCount > 0)
                                    {
                                        <div class="message-sources mt-2 p-2 bg-light rounded">
                                            <small><strong><i class="bi bi-link-45deg"></i> Sources:</strong></small>
                                            @if (internalCount > 0)
                                            {
                                                <div class="mt-1">
                                                    <small class="text-muted">
                                                        🏢 <strong>Internal:</strong> @internalCount document(s)
                                                    </small>
                                                </div>
                                            }
                                            @if (externalCount > 0)
                                            {
                                                <div class="mt-1">
                                                    <small class="text-muted">
                                                        🌐 <strong>External:</strong> @externalCount source(s)
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @* ✨ FULL RESULTS CARD - SHOW ALL OUTPUT *@
            @if (executionContext != null && executionContext.NodeOutputs.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-check-circle"></i> Results
                        </h5>
                    </div>
                    <div class="card-body">
                        @{
                            // Find the last department that ran
                            var lastDepartmentOutput = executionContext.ExecutionOrder
                                .LastOrDefault(nodeId => {
                                    var node = flow?.Nodes.FirstOrDefault(n => n.Id == nodeId);
                                    return node?.Type?.EndsWith("Department") == true &&
                                           executionContext.NodeOutputs.ContainsKey(nodeId) &&
                                           executionContext.NodeOutputs[nodeId].ContainsKey("output");
                                });
                        }

                        @if (lastDepartmentOutput != null)
                        {
                            var outputs = executionContext.NodeOutputs[lastDepartmentOutput];

                            @* Main answer output *@
                            @if (outputs.ContainsKey("output"))
                            {
                                <div class="alert alert-info">
                                    <h6 class="mb-2">
                                        <i class="bi bi-chat-quote"></i> Answer:
                                    </h6>
                                    <div>@outputs["output"]</div>
                                </div>
                            }

                            @* ✨ NEW: Show search metadata *@
                            @if (outputs.ContainsKey("source") || outputs.ContainsKey("confidence"))
                            {
                                <div class="search-metadata p-3 bg-light rounded mb-3">
                                    <h6 class="mb-2"><i class="bi bi-info-circle"></i> Search Details:</h6>

                                    @if (outputs.ContainsKey("source"))
                                    {
                                        var source = outputs["source"]?.ToString();
                                        var sourceIcon = source switch
                                        {
                                            "KnowledgeBase" => "🏢",
                                            "WebSearch" => "🌐",
                                            "Hybrid" => "🔄",
                                            _ => "🤖"
                                        };
                                        <div class="mb-2">
                                            <strong>@sourceIcon Source:</strong>
                                            <span class="badge bg-primary">@source</span>
                                        </div>
                                    }

                                    @if (outputs.ContainsKey("confidence"))
                                    {
                                        var confidence = float.Parse(outputs["confidence"]?.ToString() ?? "0");
                                        <div class="mb-2">
                                            <strong><i class="bi bi-graph-up"></i> KB Confidence:</strong>
                                            <span class="badge bg-info">@(confidence.ToString("P0"))</span>
                                        </div>
                                    }

                                    @if (outputs.ContainsKey("internalSources"))
                                    {
                                        var count = int.Parse(outputs["internalSources"]?.ToString() ?? "0");
                                        @if (count > 0)
                                        {
                                            <div class="mb-2">
                                                <strong>🏢 Internal Documents:</strong>
                                                <span class="badge bg-success">@count found</span>
                                            </div>
                                        }
                                    }

                                    @if (outputs.ContainsKey("externalSources"))
                                    {
                                        var count = int.Parse(outputs["externalSources"]?.ToString() ?? "0");
                                        @if (count > 0)
                                        {
                                            <div class="mb-2">
                                                <strong>🌐 External Sources:</strong>
                                                <span class="badge bg-warning">@count found</span>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            @if (executionContext != null)
            {
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3>
                        <i class="bi bi-file-earmark-bar-graph"></i> Latest Execution Results
                    </h3>
                    <div class="text-muted">
                        <small>Input: <strong>"@currentInputUsed"</strong></small>
                    </div>
                </div>

                <!-- 🔥 NODE OUTPUTS - ONLY SHOW NODES THAT RAN -->
                @foreach (var nodeId in executionContext.ExecutionOrder)
                {
                    var nodeDef = flow?.Nodes.FirstOrDefault(n => n.Id == nodeId);
                    var hasOutput = executionContext.NodeOutputs.ContainsKey(nodeId);
                    var outputs = hasOutput ? executionContext.NodeOutputs[nodeId] : null;
                    var hasData = outputs != null && outputs.Any();

                    // 🔥 SKIP DEPARTMENTS WITH NO OUTPUT
                    bool isDepartment = nodeDef?.Type?.EndsWith("Department") == true;
                    if (isDepartment && !hasData)
                    {
                        continue;
                    }

                    <div class="card shadow-sm mb-3 node-result-card">
                        <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0 text-white">
                                    <i class="bi bi-circle-fill"></i> @nodeId
                                </h5>
                                @if (nodeDef != null)
                                {
                                    <span class="badge bg-light text-dark">@nodeDef.Type</span>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            @if (hasData)
                            {
                                @foreach (var kvp in outputs!)
                                {
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <strong class="text-primary">
                                                <i class="bi bi-arrow-right-circle"></i> @kvp.Key
                                            </strong>
                                        </div>
                                        <div class="output-box">
                                            <pre class="mb-0">@kvp.Value</pre>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0">
                                    <i class="bi bi-info-circle"></i> No output data
                                </p>
                            }
                        </div>
                    </div>
                }

                <!-- Errors Section -->
                @if (executionContext.Errors.Any())
                {
                    <div class="card shadow-sm border-danger mb-3">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-exclamation-triangle"></i> Errors
                            </h5>
                        </div>
                        <div class="card-body">
                            @foreach (var error in executionContext.Errors)
                            {
                                <div class="alert alert-danger mb-2">
                                    <pre class="mb-0">@error</pre>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else if (!isRunning)
            {
                <div class="text-center py-5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" fill="currentColor" class="bi bi-play-circle text-muted mb-3" viewBox="0 0 16 16">
